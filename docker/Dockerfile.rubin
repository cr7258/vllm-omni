# Build docker/Dockerfile.cuda first and pass its tag as OMNI_IMAGE.
# Keep that image's vLLM/PyTorch/Triton dependencies. Install the NVIDIA
# compiler wheel outside Python's import path and select only its standalone
# assembler; the wheel's other CUDA build dependencies are not needed by ptxas.
ARG OMNI_IMAGE
FROM ${OMNI_IMAGE}
COPY requirements/rubin-ptxas.txt /opt/rubin-ptxas/requirements.txt
RUN uv pip install --target /opt/rubin-ptxas --no-deps --only-binary=:all: \
    --require-hashes -r /opt/rubin-ptxas/requirements.txt \
    && chmod 0755 /opt/rubin-ptxas/nvidia/cu13/bin/ptxas
ENV TRITON_PTXAS_BLACKWELL_PATH=/opt/rubin-ptxas/nvidia/cu13/bin/ptxas

RUN python3 -c "import importlib.metadata as m; from triton.backends.nvidia.compiler import get_ptxas; m.version('vllm-omni'); assert m.version('vllm') == '0.33.0'; assert m.version('torch').split('+')[0] == '2.14.0'; assert m.version('triton').startswith('3.8.'); assert get_ptxas(107).path == '/opt/rubin-ptxas/nvidia/cu13/bin/ptxas'; assert get_ptxas(107).version.startswith('13.4')" \
    && /opt/rubin-ptxas/nvidia/cu13/bin/ptxas --version \
    && uv pip check --python "$(python3 -c 'import sys; print(sys.executable)')"
